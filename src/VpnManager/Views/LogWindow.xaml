<Window x:Class="VpnManager.Views.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="640" Height="420" MinWidth="360" MinHeight="200"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        Background="{DynamicResource PanelBg}" KeyDown="Window_KeyDown">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
            <Button x:Name="RefreshBtn" Click="Refresh_Click" Padding="14,4" Margin="0,0,6,0" />
            <Button x:Name="CopyBtn" Click="Copy_Click" Padding="14,4" />
        </StackPanel>
        <TextBox x:Name="LogBox" Grid.Row="1" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                 FontFamily="Consolas" FontSize="13" TextWrapping="NoWrap"
                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                 Background="{DynamicResource PanelBg}" Foreground="{DynamicResource TextMain}"
                 BorderBrush="{DynamicResource PanelBorder}" Padding="6" />
    </Grid>
</Window>
