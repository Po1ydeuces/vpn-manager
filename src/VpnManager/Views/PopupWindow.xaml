<Window x:Class="VpnManager.Views.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ras="clr-namespace:VpnManager.Ras"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        SizeToContent="Height" Width="396" ShowActivated="True"
        KeyDown="Window_KeyDown" Deactivated="Window_Deactivated"
        IsVisibleChanged="Window_IsVisibleChanged" SizeChanged="Window_SizeChanged">
    <Window.Resources>
        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="10,8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="Foreground" Value="{DynamicResource DotOn}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Dot" TargetType="Ellipse">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{DynamicResource DotOff}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static ras:VpnState.Connected}">
                    <Setter Property="Fill" Value="{DynamicResource DotOn}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static ras:VpnState.Connecting}">
                    <Setter Property="Fill" Value="{DynamicResource DotBusy}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static ras:VpnState.Error}">
                    <Setter Property="Fill" Value="{DynamicResource DotError}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Margin="12" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource PanelBorder}"
            BorderThickness="1" CornerRadius="10" Padding="6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.35" />
        </Border.Effect>
        <Grid>
            <TextBlock Text="{Binding EmptyText}" Foreground="{DynamicResource TextMuted}"
                       HorizontalAlignment="Center" Margin="0,16">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid x:Name="Row">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource RowButton}" Command="{Binding ToggleCommand}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Style="{StaticResource Dot}" Margin="0,0,10,0" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis" FontSize="14"
                                                   Foreground="{DynamicResource TextMain}" />
                                            <TextBlock Text="{Binding StatusText}" FontSize="12"
                                                   Foreground="{DynamicResource TextMuted}" />
                                            <TextBlock Text="{Binding TrafficText}" ToolTip="{Binding TrafficText}" TextTrimming="CharacterEllipsis" FontSize="12"
                                                       Foreground="{DynamicResource TextMuted}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding TrafficText}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        <TextBlock Text="{Binding ErrorText}" ToolTip="{Binding ErrorText}"
                                                   FontSize="12" TextWrapping="Wrap" MaxHeight="32"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource DotError}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ErrorText}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontFamily="Consolas"
                                               FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0"
                                               Foreground="{DynamicResource TextMuted}" />
                                </Grid>
                            </Button>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="HideBtn" Style="{StaticResource IconButton}" Content="&#xE711;"
                                        Command="{Binding HideCommand}" ToolTip="{Binding HideTip}" />
                                <Button x:Name="StartBtn" Style="{StaticResource IconButton}" Content="&#xE7E8;"
                                        Command="{Binding ToggleConnectOnStartCommand}"
                                        ToolTip="{Binding ConnectOnStartTip}" Tag="{Binding ConnectOnStart}" />
                                <Button x:Name="ReconnectBtn" Style="{StaticResource IconButton}" Content="&#xE72C;"
                                        Command="{Binding ToggleAutoReconnectCommand}"
                                        ToolTip="{Binding AutoReconnectTip}" Tag="{Binding AutoReconnect}" />
                                <Button x:Name="PinBtn" Style="{StaticResource IconButton}" Content="&#xE718;"
                                        Command="{Binding TogglePinCommand}"
                                        ToolTip="{Binding PinTip}" Tag="{Binding IsPinned}" />
                            </StackPanel>
                            </Grid>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ReconnectBtn" Property="Opacity" Value="1" />
                                    <Setter TargetName="HideBtn" Property="Opacity" Value="1" />
                                    <Setter TargetName="StartBtn" Property="Opacity" Value="1" />
                                    <Setter TargetName="PinBtn" Property="Opacity" Value="1" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                    <Setter TargetName="Row" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>